<div class="col-sm-6 col-xl-4">
  <div class="bg-light rounded p-4 h-100 d-flex flex-column">
    <img
      class="rounded w-100 mb-3"
      src="<%= member.photo %>"
      alt="<%= member.name %>"
      style="height: 220px; object-fit: cover"
    />
    <h5 class="mb-1"><%= member.name %></h5>
    <p class="text-primary mb-2"><%= member.job %></p>
    <p class="text-muted mb-4">
      <i class="fa fa-map-marker-alt me-2"></i><%= member.address %>
    </p>
    <div class="mt-auto d-flex gap-2">
      <a class="btn btn-sm btn-primary" href="/staff/<%= member.id %>"
        ><i class="fa fa-eye me-1"></i>View</a
      ><a
        class="btn btn-sm btn-outline-primary"
        href="/staff/<%= member.id %>/edit"
        ><i class="fa fa-edit me-1"></i>Edit</a
      ><a
        class="btn btn-sm btn-outline-danger"
        href="/staff/<%= member.id %>/delete"
        ><i class="fa fa-trash me-1"></i>Delete</a
      >
    </div>
  </div>
</div>
