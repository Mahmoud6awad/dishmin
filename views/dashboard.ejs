<%- include('partials/head', { title: 'Dashboard' }) %>
<div class="container-fluid pt-4 px-4"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><p class="text-primary mb-1">Overview</p><h3 class="mb-0">Dashboard</h3></div><a href="/staff/new" class="btn btn-primary"><i class="fa fa-user-plus me-2"></i>Add staff member</a></div>
    <div class="row g-4 mb-4"><div class="col-sm-6 col-xl-3"><div class="bg-light rounded d-flex align-items-center justify-content-between p-4"><i class="fa fa-users fa-3x text-primary"></i><div class="ms-3"><p class="mb-2">Total Staff</p><h2 class="mb-0"><%= totalStaff %></h2></div></div></div><div class="col-sm-6 col-xl-3"><div class="bg-light rounded d-flex align-items-center justify-content-between p-4"><i class="fa fa-user-plus fa-3x text-primary"></i><div class="ms-3"><p class="mb-2">Recent Adds</p><h2 class="mb-0"><%= Math.min(totalStaff, 5) %></h2></div></div></div></div>
    <div class="bg-light rounded p-4"><div class="d-flex align-items-center justify-content-between mb-4"><h5 class="mb-0">Recently Added Staff</h5><a href="/staff">View directory</a></div><% if (staff.length) { %><div class="table-responsive"><table class="table text-start align-middle table-hover mb-0"><thead><tr class="text-dark"><th>Photo</th><th>Name</th><th>Job</th><th>Address</th><th>Added</th><th></th></tr></thead><tbody><% staff.slice(0, 5).forEach((member) => { %><tr><td><img class="rounded-circle" src="<%= member.photo %>" alt="<%= member.name %>" style="width: 42px; height: 42px; object-fit: cover;"></td><td><%= member.name %></td><td><%= member.job %></td><td><%= member.address %></td><td><%= new Date(member.createdAt).toLocaleDateString() %></td><td><a class="btn btn-sm btn-primary" href="/staff/<%= member.id %>">View</a></td></tr><% }) %></tbody></table></div><% } else { %><div class="text-center py-5"><i class="fa fa-users fa-3x text-primary mb-3"></i><h5>No staff members yet</h5><p class="text-muted mb-3">Create the first staff profile to populate your dashboard.</p><a href="/staff/new" class="btn btn-primary">Add staff member</a></div><% } %></div>
</div>
<%- include('partials/footer') %>
