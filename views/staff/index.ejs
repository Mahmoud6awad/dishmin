<%- include('../partials/head', { title: 'Staff' }) %>
<div class="container-fluid pt-4 px-4"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><p class="text-primary mb-1">Directory</p><h3 class="mb-0">Staff</h3></div><a href="/staff/new" class="btn btn-primary"><i class="fa fa-user-plus me-2"></i>Add staff member</a></div>
    <% if (staff.length) { %><div class="row g-4"><% staff.forEach((member) => { %><%- include('../partials/staff-card', { member }) %><% }) %></div><% } else { %><div class="bg-light rounded p-5 text-center"><i class="fa fa-users fa-3x text-primary mb-3"></i><h5>Your staff directory is empty</h5><p class="text-muted mb-3">Add a profile with a photo, job, and address.</p><a href="/staff/new" class="btn btn-primary">Add staff member</a></div><% } %>
</div>
<%- include('../partials/footer') %>
