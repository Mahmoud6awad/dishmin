<%- include('../partials/head', { title: 'Delete Staff' }) %>
<div class="container-fluid pt-4 px-4"><div class="mb-4"><p class="text-danger mb-1">Staff directory</p><h3 class="mb-0">Delete staff member</h3></div><div class="bg-light rounded p-4"><div class="row align-items-center g-4"><div class="col-md-3 text-center"><img class="rounded-circle" src="<%= staffMember.photo %>" alt="<%= staffMember.name %>" style="width: 160px; height: 160px; object-fit: cover;"></div><div class="col-md-9"><h4><%= staffMember.name %></h4><p class="text-primary mb-1"><%= staffMember.job %></p><p class="text-muted"><i class="fa fa-map-marker-alt me-2"></i><%= staffMember.address %></p><p>Are you sure you want to permanently delete this staff member?</p><form action="/staff/<%= staffMember.id %>/delete" method="post" class="d-flex gap-2"><button class="btn btn-danger" type="submit"><i class="fa fa-trash me-2"></i>Yes, delete</button><a class="btn btn-outline-secondary" href="/staff/<%= staffMember.id %>">Cancel</a></form></div></div></div></div>
<%- include('../partials/footer') %>
