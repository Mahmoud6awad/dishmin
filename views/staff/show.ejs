<%- include('../partials/head', { title: staffMember.name }) %>
<div class="container-fluid pt-4 px-4"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4"><div><p class="text-primary mb-1">Staff directory</p><h3 class="mb-0">Staff details</h3></div><div class="d-flex gap-2"><a href="/staff/<%= staffMember.id %>/edit" class="btn btn-primary"><i class="fa fa-edit me-2"></i>Edit</a><a href="/staff/<%= staffMember.id %>/delete" class="btn btn-outline-danger"><i class="fa fa-trash me-2"></i>Delete</a></div></div><div class="row g-4"><div class="col-lg-4"><div class="bg-light rounded p-4 text-center"><img class="rounded-circle mb-3" src="<%= staffMember.photo %>" alt="<%= staffMember.name %>" style="width: 180px; height: 180px; object-fit: cover;"><h4 class="mb-1"><%= staffMember.name %></h4><p class="text-primary mb-0"><%= staffMember.job %></p></div></div><div class="col-lg-8"><div class="bg-light rounded p-4 h-100"><h5 class="mb-4">Profile information</h5><dl class="row mb-0"><dt class="col-sm-4 mb-3">Full name</dt><dd class="col-sm-8 mb-3"><%= staffMember.name %></dd><dt class="col-sm-4 mb-3">Job title</dt><dd class="col-sm-8 mb-3"><%= staffMember.job %></dd><dt class="col-sm-4 mb-3">Address</dt><dd class="col-sm-8 mb-3"><%= staffMember.address %></dd><dt class="col-sm-4">Added</dt><dd class="col-sm-8"><%= new Date(staffMember.createdAt).toLocaleDateString() %></dd></dl></div></div></div></div>
<%- include('../partials/footer') %>
