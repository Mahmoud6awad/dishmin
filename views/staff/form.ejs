<%- include('../partials/head', { title: formTitle }) %>
<div class="container-fluid pt-4 px-4"><div class="mb-4"><p class="text-primary mb-1">Staff directory</p><h3 class="mb-0"><%= formTitle %></h3></div><div class="row g-4"><div class="col-lg-8"><div class="bg-light rounded p-4"><form action="<%= formAction %>" method="post" enctype="multipart/form-data"><div class="mb-3"><label class="form-label" for="name">Full name</label><input class="form-control" id="name" name="name" value="<%= staffMember.name || '' %>" required></div><div class="mb-3"><label class="form-label" for="job">Job title</label><input class="form-control" id="job" name="job" value="<%= staffMember.job || '' %>" required></div><div class="mb-3"><label class="form-label" for="address">Address</label><textarea class="form-control" id="address" name="address" rows="3" required><%= staffMember.address || '' %></textarea></div><div class="mb-4"><label class="form-label" for="photo">Photo</label><input class="form-control" id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/gif,image/webp"><small class="text-muted">Optional. JPG, PNG, GIF, or WebP up to 5 MB.</small></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="fa fa-save me-2"></i>Save staff member</button><a class="btn btn-outline-secondary" href="/staff">Cancel</a></div></form></div></div><div class="col-lg-4"><div class="bg-light rounded p-4"><h5 class="mb-3">Photo preview</h5><img class="rounded w-100" src="<%= staffMember.photo || '/img/user.jpg' %>" alt="Current staff photo" style="aspect-ratio: 1; object-fit: cover;"><p class="text-muted mt-3 mb-0">A clear profile photo helps the team recognize each staff member.</p></div></div></div></div>
<%- include('../partials/footer') %>
